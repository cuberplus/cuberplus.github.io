{
  "name": "cuberplus",
  "version": "0.1.0",
  "homepage": "https://cuberplus.com",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cuberplus/navigation": "file:shared/navigation",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "cubing": "^0.63.3",
    "moment": "^2.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.1",
    "react-data-grid": "^7.0.0-beta.46",
    "react-datepicker": "^4.18.0",
    "react-ga4": "^2.1.0",
    "react-multi-select-component": "^4.3.4",
    "react-select": "^5.10.2",
    "react-switch": "^7.1.0",
    "smartcube-web-bluetooth": "git+https://github.com/poliva/smartcube-web-bluetooth.git#2077416d6c828ec926dee424cf1bbfe4c0f25a47"
  },
  "scripts": {
    "postinstall": "patch-package --patch-dir timer/patches",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src shared timer/src smartcubeanalyzer/src scrambler/src",
    "build": "npm run typecheck && npm run lint && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test:web && npm run test:timer",
    "test:web": "jest --runInBand --selectProjects site analyzer",
    "test:timer": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --selectProjects timer",
    "test:site": "node scripts/check-site.mjs && node scripts/check-persistent-app.mjs && node scripts/check-scramble.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-datepicker": "^4.15.1",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.4",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "patch-package": "^8.0.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.5"
  }
}