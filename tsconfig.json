{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "jest", "web-bluetooth", "vite/client"],
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src", "shared", "timer/src", "smartcubeanalyzer/src", "scrambler/src"
  ],
  "exclude": ["**/tests/**", "**/__mocks__/**", "**/*.test.*", "**/testHelpers.ts"]
}
